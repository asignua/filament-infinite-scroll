{
    "name": "asignua/filament-infinite-scroll",
    "description": "Infinite scroll and a \"Load more\" button for Filament tables: resources, relation managers and table widgets.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "table",
        "infinite-scroll",
        "load-more",
        "pagination"
    ],
    "homepage": "https://github.com/asignua/filament-infinite-scroll",
    "support": {
        "issues": "https://github.com/asignua/filament-infinite-scroll/issues",
        "source": "https://github.com/asignua/filament-infinite-scroll"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentInfiniteScroll\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentInfiniteScroll\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentInfiniteScroll\\FilamentInfiniteScrollServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
